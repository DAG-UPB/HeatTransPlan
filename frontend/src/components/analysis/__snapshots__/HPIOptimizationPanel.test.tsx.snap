pentane_3|Steam">Isopentane_3 · Steam</option><option value="Isopentane_3|Water">Isopentane_3 · Water</option><option value="R1224yd_1|Steam">R1224yd_1 · Steam</option><option value="R1224yd_1|Water">R1224yd_1 · Water</option><option value="R1224yd_2|Steam">R1224yd_2 · Steam</option><option value="R1224yd_2|Water">R1224yd_2 · Water</option><option value="R1224yd_3|Steam">R1224yd_3 · Steam</option><option value="R1224yd_3|Water">R1224yd_3 · Water</option><option value="R1233zd_1|Steam">R1233zd_1 · Steam</option><option value="R1233zd_1|Water">R1233zd_1 · Water</option><option value="R1233zd_2|Steam">R1233zd_2 · Steam</option><option value="R1233zd_2|Water">R1233zd_2 · Water</option><option value="R1233zd_3|Steam">R1233zd_3 · Steam</option><option value="R1233zd_3|Water">R1233zd_3 · Water</option><option value="R1234ZEE_1|Water">R1234ZEE_1 · Water</option><option value="R1234ZEE_2|Water">R1234ZEE_2 · Water</option><option value="R1234ZEE_3|Water">R1234ZEE_3 · Water</option><option value="R1336mzzZ_1|Steam">R1336mzzZ_1 · Steam</option><option value="R1336mzzZ_1|Water">R1336mzzZ_1 · Water</option><option value="R1336mzzZ_2|Steam">R1336mzzZ_2 · Steam</option><option value="R1336mzzZ_2|Water">R1336mzzZ_2 · Water</option><option value="R1336mzzZ_3|Steam">R1336mzzZ_3 · Steam</option><option value="R1336mzzZ_3|Water">R1336mzzZ_3 · Water</option></select></label><label class="hpv-slider" style="color: rgb(10, 117, 196);"><span>Source profile at 66.7 °C</span><input min="48" max="73" step="0.1" style="accent-color: rgb(10, 117, 196);" type="range" value="66.67569069255336"><span class="cf-muted">48.0 – 73.0 °C along the profile · moves T source,out</span></label><label class="hpv-slider" style="color: rgb(193, 56, 160);"><span>Sink profile at 95.5 °C</span><input min="73" max="113" step="0.1" style="accent-color: rgb(193, 56, 160);" type="range" value="95.5"><span class="cf-muted">73.0 – 113.0 °C along the profile · moves T sink,out</span></label></section><section class="hpv-calc"><h4>What the optimization calculates</h4><ol><li>Demand above 95.5 °C, read off the sink profile: Q sink = <b>150.0 kW</b></li><li>COP from the 2-temperature model: <b>–</b></li><li>Waste heat the pump needs: <code>Q_sink · (COP − 1) / COP</code> = <b>–</b></li><li>Waste heat available down to 66.7 °C, read off the source profile: <b>126.5 kW</b></li><li>Electricity: <code>Q_sink / COP</code> = <b>–</b></li></ol></section></div><p class="cf-muted hpv-note">Ticked temperatures follow the search along their profile: the source one the source position, the sink one the sink position. Unticked ones stay at the pinch. Changing a tick re-runs the optimization. Q sink is read off the sink profile; P el and Q source follow from the COP.</p></div><footer class="cf-footer"><button class="cf-btn">Back to the pump's values</button><span class="cf-spacer"></span><button class="cf-btn cf-btn-primary">Close</button></footer></div></div></div>"`;

exports[`HPIOptimizationPanel > renders the same for every control > initial 1`] = `"<div class="analysis-panel " style="margin-top: 2rem;"><div class="pa-split-layout"><div class="pa-left-col"><div class="pa-hp-table-wrap" style="max-height: 440px; overflow-y: auto;"><table class="pa-table pa-hp-table"><thead style="position: sticky; top: 0px; z-index: 2;"><tr class="pa-hp-groups"><th colspan="6" style="background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);">Heat pump</th><th colspan="4" style="background: linear-gradient(rgba(143,174,224,0.20), rgba(143,174,224,0.20)), var(--surface); border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">Sink</th><th colspan="3" style="background: linear-gradient(rgba(232,139,139,0.20), rgba(232,139,139,0.20)), var(--surface); border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">Source</th></tr><tr><th style="cursor: pointer; user-select: none; white-space: nowrap; min-width: 190px; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">TYPE<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">REFRIGERANT<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">COMPR.<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; width: 1%; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">REFRIG. TYPE<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;"><span class="notranslate">COP</span><span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;"><span style="text-transform: none;">P<sub>el</sub> (kW)</span><span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; background: linear-gradient(rgba(143,174,224,0.20), rgba(143,174,224,0.20)), var(--surface); border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);"><div style="display: flex; align-items: center; gap: 0.25rem;">MEDIUM<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"><