exports[`HPIOptimizationPanel > renders the same for every control > sort_0 1`] = `"<div class="analysis-panel " style="margin-top: 2rem;"><div class="pa-split-layout"><div class="pa-left-col"><div class="pa-hp-table-wrap" style="max-height: 440px; overflow-y: auto;"><table class="pa-table pa-hp-table"><thead style="position: sticky; top: 0px; z-index: 2;"><tr class="pa-hp-groups"><th colspan="6" style="background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);">Heat pump</th><th colspan="4" style="background: linear-gradient(rgba(143,174,224,0.20), rgba(143,174,224,0.20)), var(--surface); border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">Sink</th><th colspan="3" style="background: linear-gradient(rgba(232,139,139,0.20), rgba(232,139,139,0.20)), var(--surface); border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">Source</th></tr><tr><th style="cursor: pointer; user-select: none; white-space: nowrap; min-width: 190px; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">TYPE<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">REFRIGERANT<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanatio