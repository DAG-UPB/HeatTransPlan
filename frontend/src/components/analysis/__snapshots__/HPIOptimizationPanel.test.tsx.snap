" stroke="#7E3FA8"></polyline><polyline points="480,370 290,370 290,264" class="hpv-pipe" stroke="#7E3FA8" marker-end="url(#hpv-a-fl)"></polyline><circle cx="500" cy="75" r="26" class="hpv-box" stroke="#7E3FA8"></circle><text x="500" y="81" text-anchor="middle" class="hpv-c" fill="#7E3FA8">C</text><path d="M480,358 L500,370 L480,382 Z M520,358 L500,370 L520,382 Z" class="hpv-box" stroke="#7E3FA8"></path><text x="500" y="402" text-anchor="middle" class="hpv-small" fill="#7E3FA8">Expansion valve</text><text x="538" y="104" class="hpv-label" fill="#7E3FA8">Compressor</text><text x="538" y="124" class="hpv-label" fill="#7E3FA8">P<tspan baseline-shift="sub" font-size="11">el</tspan> –</text><rect x="180" y="168" width="150" height="94" class="hpv-box" stroke="#181C62"></rect><text x="255" y="207" text-anchor="middle" class="hpv-label">Evaporator</text><text x="255" y="230" text-anchor="middle" class="hpv-label" fill="#0A75C4">Q<tspan baseline-shift="sub" font-size="11">source</tspan> –</text><rect x="670" y="168" width="150" height="94" class="hpv-box" stroke="#181C62"></rect><text x="745" y="207" text-anchor="middle" class="hpv-label">Condenser</text><text x="745" y="230" text-anchor="middle" class="hpv-label" fill="#C138A0">Q<tspan baseline-shift="sub" font-size="11">sink</tspan> 150.0 kW</text><text x="500" y="200" text-anchor="middle" class="hpv-cop">COP –</text><text x="500" y="226" text-anchor="middle" class="hpv-small">2-temperature model</text><text x="500" y="248" text-anchor="middle" class="hpv-small">Butane_1 · Water</text><foreignObject x="30" y="38" width="200" height="72"><div class="hpv-temp" style="color: rgb(10, 117, 196);"><div class="hpv-name">T<sub>source,out</sub><label class="hpv-badge hpv-searched" title="Ticked: the optimization searches this temperature along its profile (and runs again). Unticked: it is held at the pinch."><input aria-label="Search T source,out in the optimization" type="checkbox" checked="">searched</label></div><div class="hpv