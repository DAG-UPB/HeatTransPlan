;">296.3</td><td>63.2</td><td>58.2</td></tr><tr><td><div style="display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;"><span style="display: inline-block; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; background-color: rgb(219, 234, 254); color: rgb(30, 58, 138);" title="Eine Regression über Simulationsdaten von Wärmepumpen aus einer Parameterstudie eines Herstellers (verschiedene Kältemittel, Senkenmedien und Verdichterstufen), ausgewertet bei den Temperaturen dieses Punktes.">Modell</span><span style="font-size: 0.75rem; color: rgb(100, 116, 139);"></span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></div></td><td>Test</td><td>1</td><td>Custom formula</td><td style="font-weight: 600;">1.28</td><td>292.8</td><td style="border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">Custom</td><td>375.0</td><td>108.0</td><td>113.0</td><td style="border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">82.2</td><td>73.9</td><td>68.9</td></tr><tr><td><div style="display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;"><span style="display: inline-block; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; background-color: rgb(219, 234, 254); color: rgb(30, 58, 138);" title="Eine Regression über Simulationsdaten von Wärmepumpen aus einer Parameterstudie eines Herstellers (verschiedene Kältemittel, Senkenmedien und Verdichterstufen), ausgewertet bei den Temperaturen dieses Punktes.">Modell</span><span style="font-size: 0.75rem; color: r