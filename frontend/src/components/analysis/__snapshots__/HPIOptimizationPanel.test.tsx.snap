exports[`HPIOptimizationPanel > explains an empty result the same 1`] = `"<div class="analysis-panel " style="margin-top: 2rem;"><div class="pa-split-layout"><div class="pa-left-col"><div class="pa-hp-table-wrap" style="max-height: 440px; overflow-y: auto;"><div style="margin-top: 1rem; color: rgb(100, 116, 139);"><p>No heat pump can be integrated with this stream selection.</p><p style="margin-top: 0.5rem;">7 of 1773 operating points are source-limited: the heat pump covers only part of the demand above T_sink because the available waste heat runs out.</p><p style="margin-top: 0.5rem;">23 of 1773 operating points are demand-limited: they cover the full demand above T_sink but leave waste heat unused at T_source, so they sit off the source profile. They are hidden from the chart unless switched on.</p></div><p style="margin-top: 1rem; font-size: 0.85rem; color: rgb(100, 116, 139);">Click on any column header to sort. Click on any point in the chart to inspect its details and add it to the table.</p></div></div><div class="pa-right-col"><div class="pa-card pa-opt-row" style="gap: 1.5rem; align-items: flex-start;"><div class="pa-opt-filters" style="gap: 1rem; background: rgb(248, 250, 252); padding: 1rem; border-radius: 8px; border: 1px solid rgb(226, 232, 240);"><div><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">MEDIUM SINK</label><select style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; width: 100%;"><option value="All">All</option></select></div><div><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">REFRIGERANT TYPE</label><select style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; width: 100%;"><option value="All">All</option></select></div><div style="position: relative;"><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">REFRIGERANT</label><div style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; width: 100%;"><span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">All</span><span style="font-size: 0.8em; margin-left: 8px;">▼</span></div></div><div style="position: relative;"><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">NR. COMPRESSORS</label><div style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; width: 100%;"><span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">All</span><span style="font-size: 0.8em; margin-left: 8px;">▼</span></div></div><div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1rem;"><button style="padding: 0.4rem 0.8rem; background: rgb(37, 99, 235); color: rgb(255, 255, 255); border: medium; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 0.85rem; width: 100%;">Select All</button><button style="padding: 0.4rem 0.8rem; background: rgb(220, 38, 38); color: rgb(255, 255, 255); border: medium; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 0.85rem; width: 100%;">Clear Selection</button><p style="margin-top: 0.5rem; font-size: 0.8rem; color: rgb(100, 116, 139); text-align: center; font-weight: 500;">Feasible Combinations: 0</p></div><div class="cf-cop-row"><div><div class="cf-trigger-head"><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">COP MODEL</label></div><div class="cf-trigger-row"><button class="cf-trigger" title="The 2-temperature COP model (source out, sink out): the heat pump drawn, values can be tried and the COP is shown">COP model</button></div></div><div class="cf-trigger-block"><div class="cf-trigger-head"><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">COP SOURCE</label><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></div><div class="cf-trigger-row"><button class="cf-trigger " title="A custom COP formula can be pasted here to run the integration and optimization with a specific heat pump.">ƒ Use my own COP formula</button></div></div></div><details><summary style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500; cursor: pointer;">More options</summary><div class="pa-opt-toggles" style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.75rem;"></div></details></div><div class="pa-opt-chart" style="display: flex; min-width: 0px; overflow: hidden;"><div data-testid="chart">{"points":"0:1505","maxQ":null,"selected":[],"pinch":73,"mode":"net_load"}<button data-testid="chart-pick"></button></div></div></div></div></div></div>"`;

exports[`HPIOptimizationPanel > renders German the same 1`] = `"<div class="analysis-panel " style="margin-top: 2rem;"><div class="pa-split-layout"><div class="pa-left-col"><div class="pa-hp-table-wrap" style="max-height: 440px; overflow-y: auto;"><table class="pa-table pa-hp-table"><thead style="position: sticky; top: 0px; z-index: 2;"><tr class="pa-hp-groups"><th colspan="6" style="background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);">Wärmepumpe</th><th colspan="4" style="background: linear-gradient(rgba(143,174,224,0.20), rgba(143,174,224,0.20)), var(--surface); border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">Senke</th><th colspan="3" style="background: linear-gradient(rgba(232,139,139,0.20), rgba(232,139,139,0.20)), var(--surface); border-left: 2px solid color-mix(in srgb, var(--text-main) 40%, transparent);">Quelle</th></tr><tr><th style="cursor: pointer; user-select: none; white-space: nowrap; min-width: 190px; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">TYP<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; white-space: nowrap; background: linear-gradient(rgba(124,58,237,0.13), rgba(124,58,237,0.13)), var(--surface);"><div style="display: flex; align-items: center; gap: 0.25rem;">KÄLTEMITTEL<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="