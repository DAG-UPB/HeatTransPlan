# Copy to .env (kept out of git) and set per machine. docker compose reads it.

# Public address the app is served under. A domain (e.g. app.example.org) gets
# a TLS certificate automatically; leave unset to serve http://localhost.
SITE_ADDRESS=

# AI access: Connect AI on the page and the MCP server at /mcp. 1 turns it on,
# the rest of the app stays as it is.
AI_ENABLED=0

# API keys for /api and /mcp. Set a secret and every request needs a key;
# anybody gets one at once (Connect AI → ? → Get a key, or POST /api/keys), and
# the page fetches a short-lived token of its own. Keys are signed with this
# secret, so the server stores none. Make one with: openssl rand -base64 48
# Changing it invalidates every key at once (the emergency switch). Unset: no keys.
API_KEY_SECRET=
# Key ids to refuse, comma separated: the part of a key between "htp_" (or
# "htp_page_") and the first dot. Restart the backend to apply.
API_KEY_BLOCKLIST=
# Operator keys, accepted as they are (comma separated).
API_KEYS=
